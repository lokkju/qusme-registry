{
  "id": "bsky",
  "version": "2026.11.1",
  "name": "Bluesky",
  "match": ["https://bsky.app/*"],
  "account": {
    "locator": {
      "role": "button",
      "name": {
        "en": ["Switch accounts"],
        "an": ["Cambiar cuentas"],
        "ca": ["Canvia de compte"],
        "cs": ["Přepnout účty"],
        "cy": ["Newid cyfrifon"],
        "da": ["Skift konti"],
        "de": ["Accounts wechseln"],
        "eo": ["Ŝanĝi konton"],
        "es": ["Cambiar cuentas"],
        "eu": ["Kontuak aldatu"],
        "fr": ["Changer de compte"],
        "fy": ["Fan accounts wikselje"],
        "gd": ["Leum eadar cunntasan"],
        "gl": ["Cambiar de contas"],
        "hi": ["खाता बदलें"],
        "hu": ["Fiókváltás"],
        "ia": ["Cambiar contos"],
        "id": ["Ganti akun"],
        "it": ["Cambia account"],
        "ja": ["アカウントを切り替える"],
        "ko": ["계정 전환"],
        "pl": ["Przełącz konto"],
        "pt-BR": ["Trocar de conta"],
        "pt-PT": ["Trocar de conta"],
        "ro": ["Comutare conturi"],
        "ru": ["Переключить учётные записи"],
        "sv": ["Byt mellan konton"],
        "tr": ["Hesap değiştir"],
        "vi": ["Chuyển tài khoản"],
        "zh-CN": ["切换账户"],
        "zh-HK": ["切換帳號"],
        "zh-TW": ["切換帳號"]
      }
    },
    "extract": "@([a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)$"
  },
  "intents": {
    "compose": "https://bsky.app/intent/compose?text={text}"
  },
  "fields": [
    {
      "name": "text",
      "label": "Post text",
      "locators": [
        {
          "role": "textbox",
          "name": {
            "en": ["What's up?", "Write your reply", "Add another post"],
            "an": ["Qué fas?", "Redacta una respuesta", "Anyadir una atra publicación"],
            "ast": ["¿Que pasó?", "Escribir una rempuesta", "Amestar otra publicación"],
            "ca": ["Què hi ha de nou", "Escriu la teva resposta", "Afegeix una altra publicació"],
            "cs": ["Co se děje?", "Napište svou odpověď", "Přidat další příspěvek"],
            "cy": ["Beth sy'n digwydd?", "Ysgrifennwch eich ateb", "Ychwanegu postiad arall"],
            "da": ["Hvad sker der?", "Skriv dit svar", "Tilføj endnu et opslag"],
            "de": ["Was gibt's?", "Antwort schreiben", "Einen weiteren Post hinzufügen"],
            "el": ["Τι συμβαίνει;", "Γράψτε την απάντησή σας", "Προσθήκη άλλης ανάρτησης"],
            "eo": ["Kio okazas?", "Tajpu vian respondon", "Aldoni plian afiŝon"],
            "es": ["¿Qué hay de nuevo?", "Escribe una respuesta", "Añadir otra publicación"],
            "eu": ["Zer da?", "Idatzi zure erantzuna", "Gehitu beste post bat"],
            "fi": ["Mitä kuuluu?", "Kirjoita vastauksesi", "Lisää toinen julkaisu"],
            "fr": ["Quoi de neuf ?", "Rédigez votre réponse", "Ajouter un autre post"],
            "fy": ["Hoe giet it?", "Skriuw dyn reaksje", "Noch in berjocht tafoegje"],
            "ga": ["Aon scéal?", "Scríobh freagra", "Cuir postáil eile leis"],
            "gd": ["Dè do naidheachd?", "Sgrìobh do fhreagairt", "Cuir post eile ris"],
            "gl": ["Que hai de novo?", "Escribe a túa resposta", "Add another post"],
            "hi": ["क्या चल रहा है?", "अपना जवाब दें", "एक और पोस्ट जोड़ें"],
            "hu": ["Mi a helyzet?", "Válasz írása", "Válaszlánc folytatása"],
            "ia": ["Qual es le novas?", "Scribe tu responsa", "Adder un altere publication"],
            "id": ["Apa kabar?", "Tulis balasan Anda", "Tambahkan postingan lain"],
            "it": ["Come va?", "Scrivi la tua risposta", "Aggiungi un altro post"],
            "ja": ["最近どう？", "返信を書く", "他の投稿を追加"],
            "km": ["មានរឿងអី?", "សរសេរការឆ្លើយតបរបស់អ្នក", "បន្ថែមប្រកាសមួយទៀត"],
            "ko": ["무슨 일이 일어나고 있나요?", "답글 작성하기", "다른 게시물 추가하기"],
            "ne": ["के भइरहेको छ?", "तपाईंको जवाफ लेख्नुहोस्", "अर्को पोष्ट थप्नुहोस्"],
            "nl": ["Hoe gaat het?", "Schrijf je reactie", "Nog een bericht toevoegen"],
            "pl": ["Jak się masz?", "Skomentuj", "Dodaj inny wpis"],
            "pt-BR": ["E aí, qual é a boa?", "Escreva sua resposta", "Adicionar outra postagem"],
            "pt-PT": ["Como está?", "Escreva a sua resposta", "Adicionar outra publicação"],
            "ro": ["Care-i treaba?", "Scrieți-vă răspunsul", "Adăugați o altă postare"],
            "ru": ["Как дела?", "Написать ответ", "Добавить другой пост"],
            "sv": ["Vad händer?", "Skriv ditt svar", "Lägg till ett ytterligare inlägg"],
            "th": ["มีอะไรใหม่?", "เขียนคำตอบของคุณ", "Add another post"],
            "tr": ["Nasılsınız?", "Yanıtınızı yazın", "Başka gönderi ekle"],
            "uk": ["Як справи?", "Написати відповідь", "Написати ще"],
            "vi": ["Có gì mới?", "Soạn trả lời", "Thêm bài"],
            "zh-CN": ["发生了什么新鲜事？", "撰写你的回复", "添加另一则帖文"],
            "zh-HK": ["有咩大件事？", "寫低你嘅回覆", "加多另一條帖文"],
            "zh-TW": ["發生了什麼新鮮事？", "撰寫您的回覆", "加入另一則貼文"]
          }
        }
      ],
      "inject": ["insertText", "paste", "clipboard"],
      "constraints": {
        "maxLength": 300,
        "counter": "graphemes"
      }
    }
  ]
}
