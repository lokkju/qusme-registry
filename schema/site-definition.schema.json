{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lokkju/qusme-registry/schema/site-definition.schema.json",
  "title": "qus.me site definition",
  "description": "One site in the qus.me registry (lokkju/qusme docs/spec.md 10.1). Stricter than the client parser: unknown keys, injection strategies and counters are refused here, where clients ignore or skip them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "match", "fields"],
  "properties": {
    "id": {
      "description": "Site id; also the file name and the event's d tag.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "description": "CalVer YYYY.MM.N; must increase whenever the definition changes.",
      "type": "string",
      "pattern": "^\\d{4}\\.(?:0?[1-9]|1[0-2])\\.\\d{1,6}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "match": {
      "description": "Match patterns; empty when the site has no fixed hosts (each destination then supplies its own).",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:\\*|https?)://(?:\\*|(?:\\*\\.)?[^/*]+)/.*$"
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "extract"],
      "properties": {
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "extract": {
          "description": "A regular expression whose first capture group is the account.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intents": {
      "description": "Intent URL templates by name, with {text} and {origin} placeholders.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "locator": {
      "description": "An ARIA role and accessible names keyed by document.documentElement.lang, en required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "object",
          "required": ["en"],
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/names"
          },
          "properties": {
            "en": {
              "$ref": "#/$defs/names"
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "locators", "inject"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "inject": {
          "description": "Injection strategies in the order tried; clipboard, when present, is last.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["paste", "insertText", "native", "clipboard"]
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "counter": {
              "enum": ["default", "graphemes", "twitter-text"]
            }
          }
        }
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
